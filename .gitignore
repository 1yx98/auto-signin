# ============================================================
#  凭据：绝对不入库
#  真实配置留在本地（系统照常运行），仓库里只放 *.example.json
# ============================================================
config.json
notify_helper/notify_config.json

# ============================================================
#  运行产物：日志与截图（含校园网密码、微信/小程序全程截图）
# ============================================================
logs/
*.log

# ============================================================
#  人工采集的界面样本（collect_samples.py，含个人界面与定位信息）
# ============================================================
logs/samples/

# ============================================================
#  个人签到台账（history.py 自动生成，含你每日签到时间）
#  属于个人数据，不上传；仓库里只留一份脱敏示例
#  注意：忽略目录本身时 `!` 反选无效，必须写 `data/*` 才能放行示例文件
# ============================================================
data/*
!data/signin_history.example.csv

# ============================================================
#  运行时与备份（体积大 / 含明文凭据）
#  统一归档在 _backup/ 下，根目录保持干净
# ============================================================
runtime/
_backup/
_backup_*/
*.bak_*
*.bak

# ============================================================
#  自愈状态
# ============================================================
.agent/

# ============================================================
#  含明文凭据的一次性实验脚本（无任何代码引用，建议直接删掉）
# ============================================================
wifi_helper/_ie_test.ps1

# ============================================================
#  AI 助手的工作笔记（与项目本身无关）
# ============================================================
.workbuddy-ai/
.workbuddy/

# ============================================================
#  补丁包：备份/状态/临时文件不入库
#  （补丁定义 patches/*.json 与引擎 patch_engine.py 要入库，
#    它们是"可复用的修复资产"；而 _backup 是 signin.py 的原件副本，
#    体积大且会随主程序版本漂移，没必要进仓库）
# ============================================================
补丁包/_backup/
补丁包/_state.json
补丁包/__pycache__/

# 第二个补丁包（跳过无效滚动）：同样只入库定义与引擎，不入库备份/状态
跳过无效滚动补丁包/_backup/
跳过无效滚动补丁包/_state.json
跳过无效滚动补丁包/__pycache__/

# 后 5 个补丁包（僵尸窗口过滤 / 进程检测 / 进入微信判定 / 不在区域内重跑 / 记录日期判定）
# 同样只入库 patches/*.json 与 patch_engine.py，不入库运行态。
# 用通配一次覆盖全部（含以后新建的包），避免"加了新包忘了加规则"。
*补丁包/_state.json
*补丁包/__pycache__/

# AI 助手调试用的临时探针日志（非项目产物）
_tmp_probe_logs/

# 跨包注册表：记录"谁最后把 signin.py 改成什么样"。
# 它是**本机运行态**，随每次装/拆而变，入库只会造成无谓冲突 → 不入库。
.patch_packages.json

# 嵌入前的备份与临时诊断脚本
_embed_backup_signin_patched.py

# ============================================================
#  Python / 编辑器 / 系统
# ============================================================
__pycache__/
*.pyc
*.pyo
.vscode/
.idea/
Thumbs.db
desktop.ini
